# Database Connection
DATABASE_URL="postgresql://user:password@localhost:5432/metcen_ai?schema=public"

# OpenAI API Key
OPENAI_API_KEY="sk-your-openai-api-key"

# Application URL (for BetterAuth)
APP_URL="http://localhost:5173"

# Better Auth Secret (generate a random string)
BETTER_AUTH_SECRET="your-secret-key-here"

# ── Realtime NPC (Phase 1: security) ─────────────────────────────────────────
# Signs ephemeral session JWTs. Generate: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
REALTIME_JWT_SECRET=""
# Shared secret a TRUSTED server presents to POST /api/realtime/session.
# NEVER embed this in the shipped game client.
REALTIME_GAME_SERVER_API_KEY=""
# Optional default tenant labels baked into minted tokens.
REALTIME_DEFAULT_ORG_ID="org-aris888"
REALTIME_DEFAULT_GAME_ID="game-metaverse"

# Agora (moved off the Unity client) — RTC token + Conversational AI agent.
AGORA_APP_ID=""
AGORA_APP_CERTIFICATE=""
AGORA_CUSTOMER_ID=""
AGORA_CUSTOMER_SECRET=""
AGORA_AGENT_PRESET="deepgram_nova_3,openai_tts_1"
# ASR language for the NPC. Use an explicit language — "multi" code-switching
# does NOT cover Turkish and returns gibberish for Turkish speech.
REALTIME_ASR_LANGUAGE="tr-TR"

# Custom LLM the Agora agent calls (this backend's Agora endpoint).
AGENT_LLM_URL="https://your-backend/api/agora/chat/completions"
AGENT_LLM_API_KEY="sk_agent_..."
AGENT_LLM_MODEL="cmre47zog0000aw9djl1dabdp"

# ElevenLabs (moved off the Unity client) — TTS proxy.
ELEVENLABS_API_KEY=""
ELEVENLABS_VOICE_ID="79u1d6B1KAcKAP24RiMI"
ELEVENLABS_MODEL_ID="eleven_multilingual_v2"

# ── Realtime voice + translation (Phases 3–5) ────────────────────────────────
# The NPC reasons in this locale; other locales get translation.final events.
REALTIME_CANONICAL_LOCALE="tr-TR"
# Set true to run the full voice/translation protocol without provider spend.
REALTIME_VOICE_MOCK_MODE="false"
REALTIME_TRANSLATION_MOCK_MODE="false"
REALTIME_TRANSLATION_MODEL="gpt-4.1-mini"
# Per-connection audio.chunk flood guard.
REALTIME_MAX_EVENTS_PER_SECOND="50"

# ── Shared response cache (multiplayer cost control) ─────────────────────────
# Same/similar question across players → answer from DB, no GPT/ElevenLabs spend.
REALTIME_CACHE_ENABLED="true"
REALTIME_CACHE_SEMANTIC="true"          # embedding-based "similar question" match
REALTIME_CACHE_SIMILARITY="0.5"         # cosine threshold; calibrated for TR (similar≈0.6-0.9, different≈0.35)
REALTIME_CACHE_MIN_QUESTION_LEN="8"     # skip caching ultra-short/follow-up asks
REALTIME_CACHE_EMBED_MODEL="text-embedding-3-small"
# Production: npm run build && npm run start:realtime (serves app + ws gateway).
PORT="3000"
