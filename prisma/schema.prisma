// Prisma schema for FriendlyAI
// PostgreSQL + BetterAuth + Multi-Assistant System

generator client {
  provider = "prisma-client-js"
  binaryTargets = ["native", "linux-musl-openssl-3.0.x"]
}

datasource db {
	provider = "postgresql"
	url = env("DATABASE_URL")
}



// ============================================
// BetterAuth Models
// ============================================

model User {
  id            String    @id @default(cuid())
  name          String
  email         String    @unique
  emailVerified Boolean   @default(false)
  image         String?
  role          String    @default("user") // "admin" | "user"
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt
  
  sessions      Session[]
  accounts      Account[]
  chats         Chat[]
  accessGrants  UserAssistantAccess[]
}

model Session {
  id        String   @id @default(cuid())
  expiresAt DateTime
  token     String   @unique
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  ipAddress String?
  userAgent String?
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model Account {
  id                    String    @id @default(cuid())
  accountId             String
  providerId            String
  userId                String
  user                  User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  accessToken           String?
  refreshToken          String?
  idToken               String?
  accessTokenExpiresAt  DateTime?
  refreshTokenExpiresAt DateTime?
  scope                 String?
  password              String?
  createdAt             DateTime  @default(now())
  updatedAt             DateTime  @updatedAt
}

model Verification {
  id         String   @id @default(cuid())
  identifier String
  value      String
  expiresAt  DateTime
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt
}

// ============================================
// Assistant System
// ============================================

// AI Assistant - Multiple assistants can be created by admin
model Assistant {
  id                String   @id @default(cuid())
  name              String
  slug              String?  @unique // optional human-friendly id for the Agent API
  description       String?
  systemInstruction String   @db.Text
  vectorStoreId     String?
  vectorStoreName   String?
  model             String   @default("gpt-4.1-mini")
  isPublic          Boolean  @default(false) // If true, all users can access
  isActive          Boolean  @default(true)
  color             String   @default("#3B82F6") // Blue default
  icon              String   @default("bot") // Icon name
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt

  chats             Chat[]
  userAccess        UserAssistantAccess[]
  vectorStoreFiles  VectorStoreFile[]
  apiKeys           ApiKey[] // API keys permitted to invoke this assistant

  @@index([isActive])
}

// ============================================
// Agent API (external, programmatic access)
// ============================================

// API key for the Agent API. The target assistant is chosen per-request by id
// or slug; the key may only invoke assistants it is explicitly linked to
// (the `assistants` relation below). The raw key is shown once at creation;
// only its sha256 hash is stored.
model ApiKey {
  id         String      @id @default(cuid())
  name       String?     // human label, e.g. "prod-integration"
  keyHash    String      @unique // sha256(rawKey), the lookup column
  keyPrefix  String      // first chars of the raw key, for display only
  revoked    Boolean     @default(false)
  lastUsedAt DateTime?
  createdAt  DateTime    @default(now())
  assistants Assistant[] // which assistants this key is permitted to invoke
  usage      ApiKeyUsage[]
}

// One row per Agent API request made with a valid key. Powers the per-key
// usage analytics (token/access metering, source IPs, call counts).
model ApiKeyUsage {
  id           String   @id @default(cuid())
  apiKeyId     String
  apiKey       ApiKey   @relation(fields: [apiKeyId], references: [id], onDelete: Cascade)
  assistantId  String?  // which assistant was targeted (plain id; survives assistant deletion)
  ip           String?  // source IP (from X-Forwarded-For / X-Real-IP)
  status       Int      // HTTP status returned (200/400/403/404/500)
  inputTokens  Int      @default(0)
  outputTokens Int      @default(0)
  totalTokens  Int      @default(0)
  createdAt    DateTime @default(now())

  @@index([apiKeyId, createdAt])
}

// User-Assistant Access Control
model UserAssistantAccess {
  id          String    @id @default(cuid())
  userId      String
  user        User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  assistantId String
  assistant   Assistant @relation(fields: [assistantId], references: [id], onDelete: Cascade)
  grantedAt   DateTime  @default(now())
  grantedBy   String?   // Admin user ID who granted access

  @@unique([userId, assistantId])
  @@index([userId])
  @@index([assistantId])
}

// ============================================
// Chat System
// ============================================

// Chat Session - Now linked to user and assistant
model Chat {
  id          String    @id @default(cuid())
  userId      String
  user        User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  assistantId String
  assistant   Assistant @relation(fields: [assistantId], references: [id], onDelete: Cascade)
  title       String?
  messages    Message[]
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  @@index([userId])
  @@index([assistantId])
  @@index([userId, assistantId])
}

// Individual messages in a chat
model Message {
  id        String   @id @default(cuid())
  chatId    String
  chat      Chat     @relation(fields: [chatId], references: [id], onDelete: Cascade)
  role      String   // "user" | "assistant"
  content   String   @db.Text
  createdAt DateTime @default(now())

  @@index([chatId])
}

// Track uploaded files for vector stores
model VectorStoreFile {
  id            String    @id @default(cuid())
  assistantId   String
  assistant     Assistant @relation(fields: [assistantId], references: [id], onDelete: Cascade)
  openaiFileId  String    @unique
  fileName      String
  fileSize      Int
  status        String    @default("pending") // pending, completed, failed
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  @@index([assistantId])
}

// ============================================
// App Settings (Global)
// ============================================

model AppSettings {
  id        String   @id @default("default")
  appName   String   @default("FriendlyAI")
  theme     String   @default("blue") // blue, green, purple, etc.
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

// ============================================
// Realtime NPC sessions (Phase 2)
// Server-authoritative session lifecycle for the multiplayer voice NPC.
// Ported from the Aris888 metaverse platform's realtime_sessions/turns tables.
// ============================================

model RealtimeSession {
  id              String    @id @default(cuid())
  sessionId       String    @unique
  orgId           String
  gameId          String
  characterId     String
  playerId        String
  locale          String    @default("en-US")
  state           String    @default("active") // active | interrupted | closing | closed
  connectionId    String?
  ttlSeconds      Int       @default(900)
  expiresAt       DateTime
  resumeExpiresAt DateTime?
  startedAt       DateTime  @default(now())
  lastSeenAt      DateTime  @default(now())
  closedAt        DateTime?
  closeReason     String?
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt

  turns           RealtimeTurn[]

  @@index([orgId, gameId, playerId, characterId])
  @@index([state])
}

model RealtimeTurn {
  id           String    @id @default(cuid())
  turnId       String    @unique
  sessionId    String
  session      RealtimeSession @relation(fields: [sessionId], references: [sessionId], onDelete: Cascade)
  inputText    String?   @db.Text
  outputText   String?   @db.Text
  state        String    @default("started") // started | completed | failed
  inputTokens  Int       @default(0)
  outputTokens Int       @default(0)
  errorCode    String?
  createdAt    DateTime  @default(now())
  completedAt  DateTime?

  @@index([sessionId])
}

// Game-specific terminology locks for live translation (Phase 5).
// e.g. skill/map/faction names that must render identically in every language.
model RealtimeGlossaryTerm {
  id         String   @id @default(cuid())
  orgId      String
  gameId     String
  sourceTerm String
  targetTerm String
  locale     String   // target locale this lock applies to, or "*" for all
  createdAt  DateTime @default(now())

  @@unique([orgId, gameId, sourceTerm, locale])
  @@index([orgId, gameId])
}

// ============================================
// Shared response cache (multiplayer cost control)
// One NPC answered once → every player asking the same/similar question reuses
// the cached answer + audio + translations instead of hitting GPT/ElevenLabs.
// ============================================

model RealtimeResponseCache {
  id           String   @id @default(cuid())
  orgId        String
  gameId       String
  characterId  String   // the assistant/NPC this answer belongs to
  questionNorm String              // normalized question (exact-match key)
  question     String   @db.Text   // original question text
  answer       String   @db.Text   // canonical LLM answer (reused by all players)
  embedding    String?  @db.Text   // JSON float[] for semantic ("similar") match
  hitCount     Int      @default(0)
  createdAt    DateTime @default(now())
  lastUsedAt   DateTime @default(now())

  @@unique([orgId, gameId, characterId, questionNorm])
  @@index([orgId, gameId, characterId])
}

model RealtimeTtsCache {
  id         String   @id @default(cuid())
  cacheKey   String   @unique   // sha256(voiceId + "\n" + answerText)
  voiceId    String
  audio      Bytes               // cached ElevenLabs mp3
  hitCount   Int      @default(0)
  createdAt  DateTime @default(now())
  lastUsedAt DateTime @default(now())
}

model RealtimeTranslationCache {
  id         String   @id @default(cuid())
  cacheKey   String   @unique   // sha256(targetLocale + "\n" + sourceText)
  targetLocale String
  sourceText String   @db.Text
  translated String   @db.Text
  hitCount   Int      @default(0)
  createdAt  DateTime @default(now())
  lastUsedAt DateTime @default(now())
}
